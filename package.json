{
  "name": "halboxpro",
  "version": "0.1.0",
  "private": true,
  "description": "HalBoxPro - multi-tenant fish-market (balık hali) management system",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm --workspace server run dev",
    "dev:client": "npm --workspace client run dev",
    "build": "npm --workspace server run build && npm --workspace client run build",
    "test": "npm --workspace server run test",
    "test:e2e": "npm --workspace client run test:e2e",
    "seed": "npm --workspace server run seed",
    "migrate": "npm --workspace server run migrate"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
